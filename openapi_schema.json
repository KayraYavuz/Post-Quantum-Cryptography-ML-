    "/api/v1/hdf5-trace": {
      "post": {
        "summary": "Load Hdf5 Trace",
        "description": "Load a ChipWhisperer HDF5 oscilloscope trace file and return summary.\n\nReturns trace metadata, sample axis, first trace samples, stored intermediates (HW, points, labels),\nand SNR analysis. Useful for side-channel measurement import from ChipWhisperer capture files.",
        "operationId": "load_hdf5_trace_api_v1_hdf5_trace_post",
        "parameters": [
          {
            "name": "filepath",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Filepath"
            }
          },
          {
            "name": "reference_trace_idx",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "title": "Reference Trace Idx"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Body_load_hdf5_trace_api_v1_hdf5_trace_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/hdf5-snr": {
      "post": {
        "summary": "Compute Hdf5 Snr",
        "description": "Compute SNR from a ChipWhisperer HDF5 trace file.\n\nConvenience endpoint for SNR-only analysis without full trace summary.",
        "operationId": "compute_hdf5_snr_api_v1_hdf5_snr_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Hdf5TraceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "number"
                  },
                  "type": "object",
                  "title": "Response Compute Hdf5 Snr Api V1 Hdf5 Snr Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
