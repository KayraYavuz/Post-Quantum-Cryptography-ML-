  "components": {
    "schemas": {
      "Body_load_hdf5_trace_api_v1_hdf5_trace_post": {
        "properties": {
          "noise_trace_indices": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Noise Trace Indices"
          },
          "signal_indices": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Signal Indices"
          },
          "noise_sample_indices": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Noise Sample Indices"
          }
        },
        "type": "object",
        "title": "Body_load_hdf5_trace_api_v1_hdf5_trace_post"
      },
      "CPABenchmarkRequest": {
        "properties": {
          "num_traces": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 10.0,
            "title": "Num Traces",
            "description": "Number of attack power traces",
            "default": 35
          },
          "masked": {
            "type": "boolean",
            "title": "Masked",
            "description": "Whether 1st-order Boolean masking is applied",
            "default": false
          },
          "noise_std": {
            "type": "number",
            "maximum": 1.5,
            "minimum": 0.05,
            "title": "Noise Std",
            "description": "Trace Gaussian noise standard deviation",
            "default": 0.35
          }
        },
        "type": "object",
        "title": "CPABenchmarkRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hdf5TraceRequest": {
        "properties": {
          "filepath": {
            "type": "string",
            "title": "Filepath",
            "description": "Path to ChipWhisperer .hdf5 trace file"
          },
          "reference_trace_idx": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reference Trace Idx",
            "description": "Index of reference trace (default: 0)"
          },
          "noise_trace_indices": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Noise Trace Indices",
            "description": "List of trace indices for noise average"
          },
          "signal_indices": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Signal Indices",
            "description": "List of trace indices for signal average"
          },
          "noise_sample_indices": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Noise Sample Indices",
            "description": "List of sample indices for noise"
          }
        },
        "type": "object",
        "required": [
          "filepath"
        ],
        "title": "Hdf5TraceRequest"
      },
      "QuantumCostRequest": {
        "properties": {
          "scheme": {
            "type": "string",
            "title": "Scheme",
            "description": "PQC algorithm identifier",
            "default": "ml-kem-768"
          },
          "physical_error_rate": {
            "type": "number",
            "title": "Physical Error Rate",
            "description": "Physical qubit error rate",
            "default": 0.001
          }
        },
        "type": "object",
        "title": "QuantumCostRequest"
      },
      "SecurityEstimateRequest": {
        "properties": {
          "scheme": {
            "type": "string",
            "title": "Scheme",
            "description": "Algorithm name (e.g. ml-kem-512, ml-kem-768, ml-kem-1024, ml-dsa-65)",
            "default": "ml-kem-768"
          },
          "k": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "K",
            "description": "Lattice dimension module rank k"
          },
          "q": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Q",
            "description": "Prime modulus q"
          },
          "eta": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Eta",
            "description": "Noise distribution parameter eta"
          }
        },
        "type": "object",
        "title": "SecurityEstimateRequest"
      },
      "TraceInferenceRequest": {
        "properties": {
          "trace": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace",
            "description": "Normalized power trace of length 256."
          },
          "target_operation": {
            "type": "string",
            "title": "Target Operation",
            "description": "Target intermediate operation",
            "default": "ML-KEM-768 NTT Butterfly / Unpack"
          }
        },
        "type": "object",
        "title": "TraceInferenceRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}