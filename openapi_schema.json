    "/api/v1/visualize/trace": {
      "get": {
        "summary": "Get Visualize Trace",
        "description": "Get a power/EM trace waveform for dashboard visualization.\n\nParameters\n----------\nmodel:\n    Leakage model: \"unprotected\", \"protected\", or \"masked\".\ninclude_markers:\n    If True, includes NTT butterfly peak markers at the dominant leakage point.\n\nReturns\n-------\nDict with trace data suitable for SVG/Canvas rendering.",
        "operationId": "get_visualize_trace_api_v1_visualize_trace_get",
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "unprotected",
              "title": "Model"
            }
          },
          {
            "name": "include_markers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Include Markers"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Visualize Trace Api V1 Visualize Trace Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
